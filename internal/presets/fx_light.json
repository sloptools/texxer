{
  "size": 512,
  "output": "out",
  "params": {
    "ao_floor": { "targets": ["occ.out_low"] },
    "form_floor": { "targets": ["forml.out_low"] },
    "azimuth": { "targets": ["form.azimuth", "key.azimuth"] },
    "both_sides": { "targets": ["form.mirror", "key.mirror"] },
    "key_color": { "targets": ["keycol.color"] },
    "key": { "targets": ["lit.opacity"] },
    "under_color": { "targets": ["undercol.color"] },
    "under": { "targets": ["shadowed.opacity"] },
    "rim": { "targets": ["rimmed.opacity"] }
  },
  "nodes": {
    "democolor": { "type": "color", "params": { "color": "#606060" } },
    "color":     { "type": "input", "params": { "name": "color" }, "inputs": { "default": "democolor" } },
    "white":     { "type": "color", "params": { "color": "#ffffff" } },
    "ao":        { "type": "input", "params": { "name": "ao" }, "inputs": { "default": "white" } },
    "upnormal":  { "type": "color", "params": { "color": "#80ff80" } },
    "normal":    { "type": "input", "params": { "name": "normal" }, "inputs": { "default": "upnormal" } },
    "black":     { "type": "color", "params": { "color": "#000000" } },
    "edges":     { "type": "input", "params": { "name": "edges" }, "inputs": { "default": "black" } },

    "occ":       { "type": "levels", "params": { "out_low": 0.4, "gamma": 1.2 }, "inputs": { "in": "ao" } },
    "occluded":  { "type": "blend", "params": { "mode": "multiply" }, "inputs": { "a": "color", "b": "occ" } },
    "form":      { "type": "shade", "params": { "azimuth": 60, "elevation": 50, "power": 1, "wrap": true }, "inputs": { "normal": "normal" } },
    "forml":     { "type": "levels", "params": { "out_low": 0.55, "out_high": 1.1 }, "inputs": { "in": "form" } },
    "formed":    { "type": "blend", "params": { "mode": "multiply" }, "inputs": { "a": "occluded", "b": "forml" } },
    "key":       { "type": "shade", "params": { "azimuth": 60, "elevation": 55, "power": 2 }, "inputs": { "normal": "normal" } },
    "keymask":   { "type": "blend", "params": { "mode": "multiply" }, "inputs": { "a": "key", "b": "ao" } },
    "keycol":    { "type": "color", "params": { "color": "#ffd8a8" } },
    "lit":       { "type": "blend", "params": { "mode": "screen", "opacity": 0.3 }, "inputs": { "a": "formed", "b": "keycol", "mask": "keymask" } },
    "under":     { "type": "shade", "params": { "azimuth": 0, "elevation": -80, "power": 1.5 }, "inputs": { "normal": "normal" } },
    "undercol":  { "type": "color", "params": { "color": "#0a0e18" } },
    "shadowed":  { "type": "blend", "params": { "opacity": 0.3 }, "inputs": { "a": "lit", "b": "undercol", "mask": "under" } },
    "rim":       { "type": "mask", "params": { "mode": "height", "level": 0.7, "softness": 0.2, "breakup": 0 }, "inputs": { "height": "edges" } },
    "rimtop":    { "type": "blend", "params": { "mode": "multiply" }, "inputs": { "a": "rim", "b": "key" } },
    "rimcol":    { "type": "color", "params": { "color": "#ffe8c8" } },
    "rimmed":    { "type": "blend", "params": { "opacity": 0.25 }, "inputs": { "a": "shadowed", "b": "rimcol", "mask": "rimtop" } },
    "out":       { "type": "output", "inputs": { "in": "rimmed" } }
  }
}
