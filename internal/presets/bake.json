{
  "outputs": { "out": "occluded", "cavity": "cavity" },
  "params": {
    "strength":       { "default": 4,         "targets": ["slope.strength"] },
    "light":          { "default": 0.5,       "targets": ["lit.opacity"] },
    "light_color":    { "default": "#a4a9b0", "targets": ["lightcol.color"] },
    "shadow":         { "default": 0.4,       "targets": ["shaded.opacity"] },
    "shadow_color":   { "default": "#0e0f12", "targets": ["shadecol.color"] },
    "cavity_radius":  { "default": 3,         "targets": ["blurred.radius"] },
    "cavity_floor":   { "default": 0.6,       "targets": ["occlusion.out_low"] }
  },
  "nodes": {
    "height":    { "type": "input", "params": { "name": "height" } },
    "color":     { "type": "input", "params": { "name": "color" } },

    "slope":     { "type": "slope", "inputs": { "height": "height" } },
    "tops":      { "type": "levels", "params": { "in_low": 0.52, "in_high": 0.68 }, "inputs": { "in": "slope" } },
    "bottoms":   { "type": "levels", "params": { "in_low": 0.32, "in_high": 0.48, "invert": true }, "inputs": { "in": "slope" } },
    "lightcol":  { "type": "color" },
    "shadecol":  { "type": "color" },
    "lit":       { "type": "blend", "inputs": { "a": "color", "b": "lightcol", "mask": "tops" } },
    "shaded":    { "type": "blend", "inputs": { "a": "lit", "b": "shadecol", "mask": "bottoms" } },

    "blurred":   { "type": "blur", "inputs": { "in": "height" } },
    "cavity":    { "type": "blend", "params": { "mode": "subtract" }, "inputs": { "a": "blurred", "b": "height" } },
    "occlusion": { "type": "levels", "params": { "in_high": 0.15, "invert": true }, "inputs": { "in": "cavity" } },
    "occluded":  { "type": "blend", "params": { "mode": "multiply" }, "inputs": { "a": "shaded", "b": "occlusion" } }
  }
}
