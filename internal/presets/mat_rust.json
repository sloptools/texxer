{
  "size": 512,
  "output": "out",
  "params": {
    "color_stops": { "targets": ["rust.stops"] },
    "spots": { "targets": ["mix.opacity"] }
  },
  "nodes": {

    "flakes": { "type": "noise", "params": { "type": "ridged", "scale": 20, "octaves": 5, "seed": 6 } },
    "spots":  { "type": "spots", "params": { "scale": 60, "size": 0.35, "seed": 7 } },
    "mix":    { "type": "blend", "params": { "mode": "screen", "opacity": 0.5 }, "inputs": { "a": "flakes", "b": "spots" } },
    "rust":   { "type": "gradient", "params": { "stops": [{ "pos": 0.0, "color": "#1e100c" }, { "pos": 0.333, "color": "#34180e" }, { "pos": 0.667, "color": "#5a2c14" }, { "pos": 1.0, "color": "#3a1c10" }] }, "inputs": { "in": "mix" } },
    "out":    { "type": "output", "inputs": { "in": "rust" } }
  }
}
