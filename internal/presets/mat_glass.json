{
  "size": 512,
  "output": "out",
  "params": {
    "tint": { "targets": ["tint.color"] },
    "sheen_color": { "targets": ["sheencol.color"] },
    "sheen": { "targets": ["sheened.opacity"] },
    "glints": { "targets": ["glints.opacity"] }
  },
  "nodes": {
    "upnormal": { "type": "color", "params": { "color": "#80ff80" } },
    "normal":   { "type": "input", "params": { "name": "normal" }, "inputs": { "default": "upnormal" } },
    "white":    { "type": "color", "params": { "color": "#ffffff" } },
    "ao":       { "type": "input", "params": { "name": "ao" }, "inputs": { "default": "white" } },

    "tint":     { "type": "color", "params": { "color": "#0a2630" } },
    "sheen":    { "type": "shade", "params": { "azimuth": 60, "elevation": 50, "power": 10 }, "inputs": { "normal": "normal" } },
    "sheencol": { "type": "color", "params": { "color": "#3a8090" } },
    "sheened":  { "type": "blend", "params": { "mode": "screen", "opacity": 0.7 }, "inputs": { "a": "tint", "b": "sheencol", "mask": "sheen" } },
    "glint1":   { "type": "shade", "params": { "azimuth": 50, "elevation": 45, "power": 90 }, "inputs": { "normal": "normal" } },
    "glint2":   { "type": "shade", "params": { "azimuth": 140, "elevation": 30, "power": 200 }, "inputs": { "normal": "normal" } },
    "glints":   { "type": "blend", "params": { "mode": "screen", "opacity": 0.7 }, "inputs": { "a": "glint1", "b": "glint2" } },
    "glinted":  { "type": "blend", "params": { "mode": "screen" }, "inputs": { "a": "sheened", "b": "white", "mask": "glints" } },
    "occ":      { "type": "levels", "params": { "out_low": 0.4 }, "inputs": { "in": "ao" } },
    "occluded": { "type": "blend", "params": { "mode": "multiply", "opacity": 0.3 }, "inputs": { "a": "glinted", "b": "occ" } },
    "out":      { "type": "output", "inputs": { "in": "occluded" } }
  }
}
