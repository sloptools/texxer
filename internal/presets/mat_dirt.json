{
  "size": 512,
  "output": "out",
  "params": {
    "color_stops": { "targets": ["dirt.stops"] }
  },
  "nodes": {

    "tone": { "type": "noise", "params": { "scale": 12, "octaves": 4, "seed": 8 } },
    "dirt": { "type": "gradient", "params": { "stops": [{ "pos": 0.0, "color": "#0e0c0a" }, { "pos": 0.5, "color": "#1c1712" }, { "pos": 1.0, "color": "#2a2218" }] }, "inputs": { "in": "tone" } },
    "out":  { "type": "output", "inputs": { "in": "dirt" } }
  }
}
