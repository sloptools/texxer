{
  "size": 512,
  "output": "out",
  "params": {
    "blur": { "targets": ["soft.radius"] }
  },
  "nodes": {
    "demotex": { "type": "noise", "params": { "scale": 8, "octaves": 4, "seed": 98 } },
    "texture": { "type": "input", "params": { "name": "texture" }, "inputs": { "default": "demotex" } },

    "soft":    { "type": "blur", "params": { "radius": 1 }, "inputs": { "in": "texture" } },
    "out":     { "type": "output", "inputs": { "in": "soft" } }
  }
}
