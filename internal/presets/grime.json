{
  "outputs": { "out": "worn", "rust": "rustmask" },
  "params": {
    "grain":       { "default": 0.3,  "targets": ["grained.opacity"] },
    "rust":        { "default": 0,    "targets": ["rusted.opacity"] },
    "rust_spots":  { "default": 0.35, "targets": ["rustzone.opacity"] },
    "rust_colors": {
      "default": [ { "pos": 0.3, "color": "#3a2519" }, { "pos": 0.7, "color": "#5a3520" } ],
      "targets": ["rustcol.stops"]
    },
    "dirt":        { "default": 0,         "targets": ["dirty.opacity"] },
    "drips":       { "default": 0,         "targets": ["dripped.opacity"] },
    "dirt_color":  { "default": "#1a1612", "targets": ["dirtcol.color"] },
    "scratches":   { "default": 0.12,      "targets": ["scratched.opacity"] },
    "wear":        { "default": 0.25,      "targets": ["wear.out_high"] }
  },
  "nodes": {
    "color":      { "type": "input", "params": { "name": "color" } },
    "height":     { "type": "input", "params": { "name": "height" } },

    "grain":      { "type": "grunge", "params": { "kind": "grain", "size": 0.5, "seed": 1 } },
    "grained":    { "type": "blend", "params": { "mode": "overlay" }, "inputs": { "a": "color", "b": "grain" } },

    "blurred":    { "type": "blur", "params": { "radius": 3 }, "inputs": { "in": "height" } },
    "cavity":     { "type": "blend", "params": { "mode": "subtract" }, "inputs": { "a": "blurred", "b": "height" } },
    "cavitymask": { "type": "levels", "params": { "in_high": 0.05 }, "inputs": { "in": "cavity" } },
    "spots":      { "type": "grunge", "params": { "kind": "spots", "scale": 40, "size": 0.45, "seed": 2 } },
    "rustdirt":   { "type": "grunge", "params": { "kind": "dirt", "scale": 6, "coverage": 0.7, "seed": 3 } },
    "rustzone":   { "type": "blend", "params": { "mode": "screen" }, "inputs": { "a": "cavitymask", "b": "spots" } },
    "rustmask":   { "type": "blend", "params": { "mode": "multiply" }, "inputs": { "a": "rustzone", "b": "rustdirt" } },
    "rusttone":   { "type": "noise", "params": { "scale": 8, "octaves": 6, "persistence": 0.55, "seed": 4 } },
    "rustcol":    { "type": "gradient", "inputs": { "in": "rusttone" } },
    "rusted":     { "type": "blend", "inputs": { "a": "grained", "b": "rustcol", "mask": "rustmask" } },

    "dirtcol":    { "type": "color" },
    "dirtmask":   { "type": "grunge", "params": { "kind": "dirt", "scale": 4, "coverage": 0.4, "softness": 0.25, "seed": 5 } },
    "dirty":      { "type": "blend", "inputs": { "a": "rusted", "b": "dirtcol", "mask": "dirtmask" } },
    "drips":      { "type": "grunge", "params": { "kind": "streaks", "scale": 4, "coverage": 0.35, "seed": 6 } },
    "dripped":    { "type": "blend", "inputs": { "a": "dirty", "b": "dirtcol", "mask": "drips" } },

    "scratches":  { "type": "grunge", "params": { "kind": "scratches", "count": 120, "length": 14, "seed": 7 } },
    "scratched":  { "type": "blend", "params": { "mode": "screen" }, "inputs": { "a": "dripped", "b": "scratches" } },
    "curv":       { "type": "curvature", "params": { "radius": 1, "gain": 3 }, "inputs": { "height": "height" } },
    "wear":       { "type": "levels", "params": { "in_low": 0.55, "in_high": 0.85 }, "inputs": { "in": "curv" } },
    "worn":       { "type": "blend", "params": { "mode": "screen" }, "inputs": { "a": "scratched", "b": "wear" } }
  }
}
